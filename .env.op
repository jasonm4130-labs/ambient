# App Store Connect API credentials for notarization, as 1Password references.
# This file holds no secrets and is committed deliberately; `op run` resolves
# each op:// reference at call time.
#
#   op run --env-file .env.op -- ./release.sh
#
# Create the item once (the .p8 is downloadable exactly once from App Store
# Connect — if it is lost, revoke the key and make a new one):
#
#   op item create --category="API Credential" --title="Apple Notarization" \
#     'key id=...' 'issuer id=...' 'team id=...'
#   op item edit "Apple Notarization" 'private key=<paste the .p8 contents>'
#
AC_API_KEY_ID=op://Private/Apple Notarization/key id
AC_API_ISSUER_ID=op://Private/Apple Notarization/issuer id
AC_API_KEY_P8=op://Private/Apple Notarization/private key
