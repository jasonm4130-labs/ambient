#!/usr/bin/env bash
# The memory gate: transcribe a whole public meeting the way the app does
# after Stop, and fail if the largest process involved exceeds a budget.
#
#   scripts/memory                    # MEMORY OK peak=<MiB> budget=<MiB>
#   scripts/memory --budget 1434      # gate against another budget, in MiB
#   AMBIENT_MEMORY_BUDGET_MIB=1434 scripts/memory
#
# The run is src/bin/memrun.rs: AMI TS3003a Mix-Headset, all 1505.6 s and four
# speakers, on both tracks of a session, through session::transcribe_session.
# The models run in ambient-engine, one process per stage (ADR 0020), so the
# figure gated is the larger of memrun's own peak footprint (from
# /usr/bin/time -l) and the largest helper peak resident set it reports
# (ENGINE_PEAK lines). It never records: the audio is the corpus file
# scripts/fetch-fixtures downloads and pins by digest for the der set, and the
# 16 kHz copy is cached under ~/.cache/ambient/fixtures/memory.
#
# The budget is a ceiling, not a baseline. The ONNX pipeline peaked at 859 and
# 1116 MiB here; the default stays at 1320 MiB until a fresh measurement on
# the helper sets a lower one (docs/developing/measurements.md#memory-gate).
# Lower it to a measurement; do not raise it to make a change pass.
set -uo pipefail
cd "$(dirname "$0")/.." || exit

budget_mib=${AMBIENT_MEMORY_BUDGET_MIB:-1320}
meeting=TS3003a
cache="$HOME/.cache/ambient"
source="$cache/ami/$meeting.Mix-Headset.wav"
out="$cache/fixtures/memory"

while [ $# -gt 0 ]; do
  case "$1" in
    --budget)
      [ $# -ge 2 ] || {
        echo "usage: scripts/memory [--budget <MiB>]" >&2
        exit 2
      }
      budget_mib=$2
      shift 2
      ;;
    *)
      echo "usage: scripts/memory [--budget <MiB>]" >&2
      exit 2
      ;;
  esac
done
case "$budget_mib" in
  '' | *[!0-9]*)
    echo "ERROR the budget is whole MiB, not '$budget_mib'" >&2
    exit 2
    ;;
esac

log=$(mktemp)
trap 'rm -f "$log"' EXIT

if [ ! -f "$source" ]; then
  echo "ERROR no $source: run scripts/fetch-fixtures (the der set needs ffmpeg)"
  exit 1
fi
mkdir -p "$out"
sixteen="$out/$meeting.16k.wav"
for pair in "16000 $sixteen"; do
  rate=${pair%% *}
  wav=${pair#* }
  [ -f "$wav" ] && continue
  if ! ffmpeg -v error -nostdin -y -i "$source" -ac 1 -ar "$rate" -sample_fmt s16 "$wav.tmp.wav" >"$log" 2>&1; then
    echo "ERROR could not resample $source to $rate Hz"
    cat "$log"
    rm -f "$wav.tmp.wav"
    exit 1
  fi
  mv "$wav.tmp.wav" "$wav"
done

# Build first and run the binary itself: under `cargo run`, time -l would
# report cargo's footprint, not the replay's.
if ! bin=$(cargo build --release --bin memrun --message-format=json 2>"$log" |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "memrun") | .executable' |
  tail -n 1) || [ -z "$bin" ] || [ "$bin" = null ]; then
  echo "ERROR cargo build --release --bin memrun"
  cat "$log"
  exit 1
fi
echo "✓ cargo build --release --bin memrun"
if ! engine=$(scripts/build-engine 2>"$log"); then
  echo "ERROR scripts/build-engine"
  cat "$log"
  exit 1
fi
echo "✓ scripts/build-engine"

if ! AMBIENT_ENGINE="$engine" AMBIENT_MODELS="${AMBIENT_MODELS:-$PWD/models}" \
  /usr/bin/time -l "$bin" "$sixteen" >"$log" 2>&1; then
  echo "ERROR memrun $meeting"
  cat "$log"
  exit 1
fi
echo "✓ memrun $meeting"

peak_bytes=$(awk '/peak memory footprint/ { print $1 }' "$log")
rss_bytes=$(awk '/maximum resident set size/ { print $1 }' "$log")
if [ -z "$peak_bytes" ]; then
  echo "ERROR /usr/bin/time -l printed no peak memory footprint"
  cat "$log"
  exit 1
fi
engine_bytes=$(awk '/^ENGINE_PEAK/ { if ($3 > m) m = $3 } END { print m + 0 }' "$log")
app_mib=$((peak_bytes / 1048576))
engine_mib=$((engine_bytes / 1048576))
peak_mib=$((app_mib > engine_mib ? app_mib : engine_mib))
rss_mib=$((${rss_bytes:-0} / 1048576))

if [ "$peak_mib" -gt "$budget_mib" ]; then
  echo "ERROR peak footprint ${peak_mib} MiB is over the ${budget_mib} MiB budget (peak RSS ${rss_mib} MiB)"
  grep '^MARK' "$log"
  exit 1
fi
grep '^ENGINE_PEAK' "$log" | awk '{ printf "  %s peak %d MiB\n", $2, $3 / 1048576 }'
echo "MEMORY OK peak=${peak_mib}MiB budget=${budget_mib}MiB app=${app_mib}MiB engine=${engine_mib}MiB rss=${rss_mib}MiB"
