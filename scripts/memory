#!/usr/bin/env bash
# The memory gate: replay a whole public meeting through the recording path
# and fail if the process's peak physical footprint exceeds a budget. Physical
# footprint is the figure Activity Monitor's Memory column shows, and the one a
# per-app RAM ceiling sees.
#
#   scripts/memory                    # MEMORY OK peak=<MiB> budget=<MiB>
#   scripts/memory --budget 1434      # gate against another budget, in MiB
#   AMBIENT_MEMORY_BUDGET_MIB=1434 scripts/memory
#
# The replay is src/bin/memrun.rs: AMI TS3003a Mix-Headset, all 1505.6 s and
# four speakers, resampled to 48 kHz and streamed in 200 ms drains into
# LiveTranscriber on both tracks at 15x realtime, then Stop and
# session::transcribe_session (ASR tail, repair, diarize, markdown). It never
# records: the audio is the corpus file scripts/fetch-fixtures downloads and
# pins by digest for the der set. The 48 kHz and 16 kHz copies are cached
# under ~/.cache/ambient/fixtures/memory, never in the repo.
#
# The budget is a ceiling, not a baseline: peak footprint moves by tens of MiB
# between runs on one machine, so there is no --update and no committed
# measurement. It starts about 200 MiB above what main measured when this gate
# landed (2012 and 2204 MiB peak footprint over two runs, prepacking on,
# finalize in-process; see docs/developing/measurements.md#memory-gate), so
# main passes and a regression past that point fails. The target is 1434 MiB (1.4 GiB), once three changes have
# landed: prepacking off on the Parakeet sessions, repair_from_native
# streaming instead of reading whole native WAVs, and finalize in a child
# process. Lower the default below as each lands; do not raise it to make a
# change pass.
#
# /usr/bin/time -l reports the peak of the process it runs. When finalize
# moves to a child process, the child's peak has to be gated as well, or this
# gate measures only the recording half.
set -uo pipefail
cd "$(dirname "$0")/.." || exit

budget_mib=${AMBIENT_MEMORY_BUDGET_MIB:-2400}
pace=15
meeting=TS3003a
cache="$HOME/.cache/ambient"
source="$cache/ami/$meeting.Mix-Headset.wav"
out="$cache/fixtures/memory"

while [ $# -gt 0 ]; do
  case "$1" in
    --budget)
      [ $# -ge 2 ] || {
        echo "usage: scripts/memory [--budget <MiB>]" >&2
        exit 2
      }
      budget_mib=$2
      shift 2
      ;;
    *)
      echo "usage: scripts/memory [--budget <MiB>]" >&2
      exit 2
      ;;
  esac
done
case "$budget_mib" in
  '' | *[!0-9]*)
    echo "ERROR the budget is whole MiB, not '$budget_mib'" >&2
    exit 2
    ;;
esac

log=$(mktemp)
trap 'rm -f "$log"' EXIT

if [ ! -f "$source" ]; then
  echo "ERROR no $source: run scripts/fetch-fixtures (the der set needs ffmpeg)"
  exit 1
fi
mkdir -p "$out"
native="$out/$meeting.48k.wav"
sixteen="$out/$meeting.16k.wav"
for pair in "48000 $native" "16000 $sixteen"; do
  rate=${pair%% *}
  wav=${pair#* }
  [ -f "$wav" ] && continue
  if ! ffmpeg -v error -nostdin -y -i "$source" -ac 1 -ar "$rate" -sample_fmt s16 "$wav.tmp.wav" >"$log" 2>&1; then
    echo "ERROR could not resample $source to $rate Hz"
    cat "$log"
    rm -f "$wav.tmp.wav"
    exit 1
  fi
  mv "$wav.tmp.wav" "$wav"
done

# Build first and run the binary itself: under `cargo run`, time -l would
# report cargo's footprint, not the replay's.
if ! bin=$(cargo build --release --bin memrun --message-format=json 2>"$log" |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "memrun") | .executable' |
  tail -n 1) || [ -z "$bin" ] || [ "$bin" = null ]; then
  echo "ERROR cargo build --release --bin memrun"
  cat "$log"
  exit 1
fi
echo "✓ cargo build --release --bin memrun"

if ! /usr/bin/time -l "$bin" "$native" "$sixteen" "$pace" >"$log" 2>&1; then
  echo "ERROR memrun $meeting"
  cat "$log"
  exit 1
fi
echo "✓ memrun $meeting at ${pace}x"

peak_bytes=$(awk '/peak memory footprint/ { print $1 }' "$log")
rss_bytes=$(awk '/maximum resident set size/ { print $1 }' "$log")
if [ -z "$peak_bytes" ]; then
  echo "ERROR /usr/bin/time -l printed no peak memory footprint"
  cat "$log"
  exit 1
fi
peak_mib=$((peak_bytes / 1048576))
rss_mib=$((${rss_bytes:-0} / 1048576))

if [ "$peak_mib" -gt "$budget_mib" ]; then
  echo "ERROR peak footprint ${peak_mib} MiB is over the ${budget_mib} MiB budget (peak RSS ${rss_mib} MiB)"
  grep '^MARK' "$log"
  exit 1
fi
echo "MEMORY OK peak=${peak_mib}MiB budget=${budget_mib}MiB rss=${rss_mib}MiB"
