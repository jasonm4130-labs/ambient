#!/usr/bin/env bash
# The quality gate: WER on the LibriSpeech and Earnings-21 calls fixtures and
# DER on the AMI fixture (300 s clips and whole meetings), each against a
# committed baseline, then scripts/memory. Quiet like scripts/check.
#
#   scripts/quality             # ✓ per step, then QUALITY OK clean=<wer> calls=<wer> der=<der> der_full=<der> memory=<MiB>
#   scripts/quality --update    # record this run as the new baseline
#
# A row may drift up half a point of WER or a point of DER before it counts as
# a regression: both are deterministic on one machine but not across model or
# runtime versions, and DER's clustering is the more sensitive to a runtime
# change. Whole meetings are gated because 300 s clips hid a clustering that
# found 30-odd speakers in a 4-person meeting.
#
# Baselines hold accuracy only, no timings: timings move every run and would
# bury the one number the diff exists to show.
set -uo pipefail
cd "$(dirname "$0")/.." || exit

tolerance=0.005
baseline=quality/wer.json
calls_tolerance=0.005
calls_baseline=quality/calls.json
der_tolerance=0.01
der_baseline=quality/der.json
full_tolerance=0.01
full_baseline=quality/der-full.json

update=""
for arg in "$@"; do
  case "$arg" in
    --update) update=1 ;;
    *)
      echo "usage: scripts/quality [--update]" >&2
      exit 2
      ;;
  esac
done

log=$(mktemp)
rows=$(mktemp)
calls_rows=$(mktemp)
der_rows=$(mktemp)
full_rows=$(mktemp)
trap 'rm -f "$log" "$rows" "$calls_rows" "$der_rows" "$full_rows"' EXIT

run() {
  if "$@" >"$log" 2>&1; then
    echo "✓ $*"
  else
    echo "ERROR $*"
    cat "$log"
    exit 1
  fi
}

run scripts/fetch-fixtures
if ! AMBIENT_ENGINE=$(scripts/build-engine 2>"$log"); then
  echo "ERROR scripts/build-engine"
  cat "$log"
  exit 1
fi
echo "✓ scripts/build-engine"
export AMBIENT_ENGINE
export AMBIENT_MODELS="${AMBIENT_MODELS:-$PWD/models}"
run cargo run --release --bin wer -- --json "$rows"
run cargo run --release --bin wer -- --manifest "$HOME/.cache/ambient/fixtures/calls/manifest.json" --json "$calls_rows"
run cargo run --release --bin der -- --json "$der_rows"
run cargo run --release --bin der -- --manifest "$HOME/.cache/ambient/fixtures/der-full/manifest.json" --json "$full_rows"
# A budget, not a baseline: --update leaves it alone.
run scripts/memory
memory=$(sed -n 's/^MEMORY OK peak=\([0-9]*\)MiB.*/\1/p' "$log")MiB

current=$(jq '[.[] | {speaker, reference_words, substitutions, insertions, deletions, wer}]' "$rows")
total=$(jq -r '.[] | select(.speaker == "total") | .wer' "$rows")
if [ -z "$current" ] || [ -z "$total" ]; then
  echo "ERROR the wer run produced no total row"
  cat "$rows"
  exit 1
fi
total=$(printf '%.4f' "$total")

calls_current=$(jq '[.[] | {speaker, reference_words, substitutions, insertions, deletions, wer}]' "$calls_rows")
calls_total=$(jq -r '.[] | select(.speaker == "total") | .wer' "$calls_rows")
if [ -z "$calls_current" ] || [ -z "$calls_total" ]; then
  echo "ERROR the calls run produced no total row"
  cat "$calls_rows"
  exit 1
fi
calls_total=$(printf '%.4f' "$calls_total")

der_current=$(jq '[.[] | {meeting, seconds, reference_speakers, hypothesis_speakers, missed_s, false_alarm_s, confusion_s, der}]' "$der_rows")
der_total=$(jq -r '.[] | select(.meeting == "total") | .der' "$der_rows")
if [ -z "$der_current" ] || [ -z "$der_total" ]; then
  echo "ERROR the der run produced no total row"
  cat "$der_rows"
  exit 1
fi
der_total=$(printf '%.4f' "$der_total")

full_current=$(jq '[.[] | {meeting, seconds, reference_speakers, hypothesis_speakers, missed_s, false_alarm_s, confusion_s, der}]' "$full_rows")
full_total=$(jq -r '.[] | select(.meeting == "total") | .der' "$full_rows")
if [ -z "$full_current" ] || [ -z "$full_total" ]; then
  echo "ERROR the full-meeting der run produced no total row"
  cat "$full_rows"
  exit 1
fi
full_total=$(printf '%.4f' "$full_total")

record() {
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" >"$1"
  echo "wrote $1"
}

if [ -n "$update" ]; then
  record "$baseline" "$current"
  record "$calls_baseline" "$calls_current"
  record "$der_baseline" "$der_current"
  record "$full_baseline" "$full_current"
  echo "QUALITY UPDATED clean=$total calls=$calls_total der=$der_total der_full=$full_total memory=$memory"
  exit 0
fi

# Drift is reported both ways. A vanished baseline row matters most: the total
# over what remains can sit below the baseline while part of the fixture is gone.
#
# jq's status is checked: an unreadable baseline prints nothing and exits
# non-zero, and an empty offender list means pass.
compare() {
  local rows=$1 base=$2 key=$3 rate=$4 tol=$5
  local offenders
  if ! offenders=$(jq -r --slurpfile base "$base" --argjson tol "$tol" \
    --arg key "$key" --arg rate "$rate" '
    (map({key: .[$key], value: .[$rate]}) | from_entries) as $c
    | ($base[0] | map({key: .[$key], value: .[$rate]}) | from_entries) as $b
    | (($c | keys) + ($b | keys) | unique)[]
    | select($c[.] == null or $b[.] == null or $c[.] > $b[.] + $tol)
    | [., ($c[.] // -1), ($b[.] // -1)] | @tsv' "$rows"); then
    echo "ERROR $base could not be read as the rows this run produced"
    cat "$base"
    exit 1
  fi

  [ -n "$offenders" ] || return 0

  echo "ERROR the run does not match $base: a row rose by more than $tol, or the fixture changed"
  printf '%-9s %8s %8s %8s\n' "$key" "$rate" baseline delta
  while IFS=$'\t' read -r name value base_value; do
    if [ "$base_value" = "-1" ]; then
      printf '%-9s %8.4f %8s %8s\n' "$name" "$value" none new
    elif [ "$value" = "-1" ]; then
      printf '%-9s %8s %8.4f %8s\n' "$name" none "$base_value" missing
    else
      printf '%-9s %8.4f %8.4f %8.4f\n' "$name" "$value" "$base_value" \
        "$(awk -v a="$value" -v b="$base_value" 'BEGIN { printf "%.4f", a - b }')"
    fi
  done <<<"$offenders"
  echo "an intended change is recorded with scripts/quality --update"
  exit 1
}

# A missing baseline is recorded per metric, so adding a metric never stops
# the others being checked.
baselined=""
if [ -f "$baseline" ]; then
  compare "$rows" "$baseline" speaker wer "$tolerance"
else
  record "$baseline" "$current"
  baselined=1
fi

if [ -f "$calls_baseline" ]; then
  compare "$calls_rows" "$calls_baseline" speaker wer "$calls_tolerance"
else
  record "$calls_baseline" "$calls_current"
  baselined=1
fi

if [ -f "$der_baseline" ]; then
  compare "$der_rows" "$der_baseline" meeting der "$der_tolerance"
else
  record "$der_baseline" "$der_current"
  baselined=1
fi

if [ -f "$full_baseline" ]; then
  compare "$full_rows" "$full_baseline" meeting der "$full_tolerance"
else
  record "$full_baseline" "$full_current"
  baselined=1
fi

if [ -n "$baselined" ]; then
  echo "QUALITY BASELINE clean=$total calls=$calls_total der=$der_total der_full=$full_total memory=$memory"
  exit 0
fi

echo "QUALITY OK clean=$total calls=$calls_total der=$der_total der_full=$full_total memory=$memory"
