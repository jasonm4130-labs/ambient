#!/usr/bin/env bash
# The rust CI job's steps, run locally: one "✓ <step>" line per step, then
# CHECK OK; on failure, "ERROR <step>" and that step's full log.
#
#   scripts/check
#
# Narrower than CI: typos, cargo-deny, the ui job, the settings bundle drift
# check and make-app.sh run only on the pull request.
set -uo pipefail
cd "$(dirname "$0")/.."
log=$(mktemp)
trap 'rm -f "$log"' EXIT

run() {
  if "$@" >"$log" 2>&1; then
    echo "✓ $*"
  else
    echo "ERROR $*"
    cat "$log"
    exit 1
  fi
}

run cargo fmt --check
run cargo clippy --all-targets -- -D warnings
run cargo test --all-targets
run cargo run --bin symbolcheck
run scripts/test-engine
echo "CHECK OK"
