#!/usr/bin/env bash
# Build the measurement fixtures under ~/.cache/ambient, never in the repo:
# the sources are hundreds of megabytes and the licences are the upstream
# corpora's, not ours. Two sets:
#
#   fixtures/wer  word error rate, from LibriSpeech test-clean (CC BY 4.0,
#                 openslr.org/12)
#   fixtures/der  diarization error rate, from AMI Mix-Headset audio
#                 (CC BY 4.0) with the pyannote only_words references
#
#   scripts/fetch-fixtures            # cached after the first run
#   scripts/fetch-fixtures --force    # rebuild both fixtures from the cache
#
# Safe to run every night. Each source is fetched once; a second run touches
# the network never and rewrites nothing. --force rebuilds the fixtures from
# the already-downloaded sources — it does not re-download them, because they
# were verified when they landed and are checked against pinned digests on
# every run.
#
# For wer, the three speakers are the first three directories in sorted order
# and the chapter is that speaker's first, so which audio this scores is a
# property of the corpus rather than a list someone typed. Each chapter's
# utterances are concatenated in id order with 700 ms of silence between them:
# one long track per speaker is what `ambient record` actually sees, and the
# gaps give the VAD turn boundaries to find. The der set is described where it
# is built, below.
set -euo pipefail

url=https://www.openslr.org/resources/12/test-clean.tar.gz
cache="$HOME/.cache/ambient"
libri="$cache/librispeech"
tarball="$libri/test-clean.tar.gz"
corpus="$libri/LibriSpeech/test-clean"
out="$cache/fixtures/wer"

speakers=3
gap_ms=700
rate=16000
bytes_per_second=$((rate * 2)) # 16 kHz mono 16-bit

force=""
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    *)
      echo "usage: scripts/fetch-fixtures [--force]" >&2
      exit 2
      ;;
  esac
done

if command -v ffmpeg >/dev/null 2>&1; then
  decoder=ffmpeg
elif command -v afconvert >/dev/null 2>&1; then
  decoder=afconvert
else
  echo "fetch-fixtures: need ffmpeg or afconvert to decode FLAC" >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Emit $1 as $2 little-endian bytes. Used to write the wav header by hand:
# both decoders are asked for headerless PCM so the utterances and the silence
# can be concatenated as bytes, which leaves the container to us.
le() {
  local n=$1 w=$2 i
  for ((i = 0; i < w; i++)); do
    printf '%b' "$(printf '\\0%03o' $(((n >> (i * 8)) & 255)))"
  done
}

# Echo "<offset> <length>" of a wav's data chunk payload. afconvert writes an
# extensible fmt chunk, so the header is not the textbook 44 bytes and the
# chunks have to be walked.
wav_data() {
  local f=$1 off=12 id size
  while :; do
    id=$(dd if="$f" bs=1 skip="$off" count=4 2>/dev/null)
    size=$(od -An -tu4 -j $((off + 4)) -N4 "$f" | tr -d ' ')
    [ -n "$id" ] && [ -n "$size" ] || return 1
    if [ "$id" = data ]; then
      echo "$((off + 8)) $size"
      return 0
    fi
    off=$((off + 8 + size + size % 2))
  done
}

# Decode $1 to headerless 16 kHz mono signed 16-bit little-endian PCM at $2.
decode_raw() {
  if [ "$decoder" = ffmpeg ]; then
    ffmpeg -v error -nostdin -y -i "$1" -ar "$rate" -ac 1 -f s16le -acodec pcm_s16le "$2"
  else
    afconvert -f WAVE -d "LEI16@$rate" -c 1 "$1" "$tmp/decoded.wav"
    local off len
    read -r off len < <(wav_data "$tmp/decoded.wav")
    tail -c "+$((off + 1))" "$tmp/decoded.wav" | head -c "$len" >"$2"
  fi
}

seconds_of() { # $1 wav -> duration to two decimals
  local off len
  read -r off len < <(wav_data "$1")
  awk -v b="$len" -v r="$bytes_per_second" 'BEGIN { printf "%.2f", b / r }'
}

if [ ! -f "$tarball" ]; then
  mkdir -p "$libri"
  echo "fetching test-clean.tar.gz (about 330 MB) ..."
  if ! curl -fSL --progress-bar -o "$tarball.part" "$url"; then
    rm -f "$tarball.part"
    echo "fetch-fixtures: download failed: $url" >&2
    exit 1
  fi
  mv "$tarball.part" "$tarball"
fi

if [ ! -d "$corpus" ]; then
  if ! tar -tzf "$tarball" >/dev/null 2>&1; then
    rm -f "$tarball"
    echo "fetch-fixtures: $tarball is truncated or not a gzip archive; deleted it, run again" >&2
    exit 1
  fi
  echo "extracting test-clean ..."
  tar -xzf "$tarball" -C "$libri" LibriSpeech/test-clean
fi

mkdir -p "$out"
head -c $((gap_ms * bytes_per_second / 1000)) /dev/zero >"$tmp/gap.raw"

files=0
total=0
entries=""

while read -r speaker_dir; do
  speaker=$(basename "$speaker_dir")
  chapter_dir=$(find "$speaker_dir" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort | head -1)
  chapter=$(basename "$chapter_dir")
  trans="$chapter_dir/$speaker-$chapter.trans.txt"
  [ -f "$trans" ] || {
    echo "fetch-fixtures: no transcript at $trans" >&2
    exit 1
  }

  wav="$out/$speaker.wav"
  txt="$out/$speaker.txt"

  if [ -z "$force" ] && [ -f "$wav" ] && [ -f "$txt" ]; then
    utterances=$(wc -l <"$txt" | tr -d ' ')
    duration=$(seconds_of "$wav")
    echo "already present: $wav"
    echo "already present: $txt"
  else
    : >"$tmp/track.raw"
    : >"$tmp/track.txt"
    utterances=0
    while read -r flac; do
      id=$(basename "$flac" .flac)
      # The reference is scored word by word, so the utterance id is dropped
      # and only the words survive — an id left in would count as a word that
      # was never spoken.
      line=$(sed -n "s/^$id //p" "$trans")
      [ -n "$line" ] || {
        echo "fetch-fixtures: $trans has no line for $id" >&2
        exit 1
      }
      [ "$utterances" -eq 0 ] || cat "$tmp/gap.raw" >>"$tmp/track.raw"
      decode_raw "$flac" "$tmp/utterance.raw"
      cat "$tmp/utterance.raw" >>"$tmp/track.raw"
      printf '%s\n' "$line" >>"$tmp/track.txt"
      utterances=$((utterances + 1))
    done < <(find "$chapter_dir" -maxdepth 1 -name '*.flac' | LC_ALL=C sort)

    n=$(wc -c <"$tmp/track.raw" | tr -d ' ')
    {
      printf 'RIFF'
      le $((36 + n)) 4
      printf 'WAVEfmt '
      le 16 4
      le 1 2
      le 1 2
      le "$rate" 4
      le "$bytes_per_second" 4
      le 2 2
      le 16 2
      printf 'data'
      le "$n" 4
      cat "$tmp/track.raw"
    } >"$wav"
    mv "$tmp/track.txt" "$txt"
    duration=$(awk -v b="$n" -v r="$bytes_per_second" 'BEGIN { printf "%.2f", b / r }')
    echo "wrote $wav ($utterances utterances, ${duration}s)"
    echo "wrote $txt"
  fi

  files=$((files + 2))
  total=$(awk -v a="$total" -v b="$duration" 'BEGIN { printf "%.2f", a + b }')
  entries="$entries$(
    printf '  {"wav": "%s", "reference": "%s", "speaker": "%s", "utterances": %d, "seconds": %s}' \
      "$wav" "$txt" "$speaker" "$utterances" "$duration"
  )"$'\n'
done < <(find "$corpus" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort | head -"$speakers")

manifest="$out/manifest.json"
if [ -z "$force" ] && [ -f "$manifest" ]; then
  echo "already present: $manifest"
else
  {
    echo '['
    printf '%s' "$entries" | sed '$!s/$/,/'
    echo ']'
  } >"$manifest"
  echo "wrote $manifest"
fi
files=$((files + 1))

# --- the diarization error rate set ----------------------------------------
#
# ES2004a, IS1009a and TS3003a are the first meeting of three AMI test-set
# series, one from each recording site (Edinburgh, Idiap, TNO), so which
# meetings this scores is a property of the corpus rather than a list someone
# typed. References are the pyannote only_words RTTMs, pinned to one revision.
ami="$cache/ami"
der_out="$cache/fixtures/der"
meetings="ES2004a IS1009a TS3003a"
der_seconds=300
rttm_rev=67c2d539286e89f68952d5dcf83912bd9f01dfae
audio_base=https://groups.inf.ed.ac.uk/ami/AMICorpusMirror/amicorpus
rttm_base=https://raw.githubusercontent.com/pyannote/AMI-diarization-setup

# shasum -a 256 of the six downloads, in sha256sum's own layout. Pinned so an
# upstream re-encode or a reference edit fails the fetch rather than quietly
# moving the DER baseline underneath the quality gate.
ami_digests="
3e2560b19bee6952c7c7ce041b0f1ea8a7ea9468044c4eea79d2a2c67e24ab0f  ES2004a.Mix-Headset.wav
9869c6146c2fd9595403edb36c2caeda65c12ffa2c0af4ce48d6814b673fd5a9  ES2004a.rttm
6eb5a0ede0d9e72794f976ce7bea5b78133eae969f99b4c5418b43c2468d25b1  IS1009a.Mix-Headset.wav
ba38d35ca567f3f1e061d90fdc33579ce60d2060fc8664eaeb77d2e0fcd88b01  IS1009a.rttm
b6ce59ff735c234afdd94b13744aa26f6785af746170543fd03b33160e920a6d  TS3003a.Mix-Headset.wav
57137f098ee3be9b8d77c9faa4b16e9155e821bdbf21b974dd8771d7e646d185  TS3003a.rttm
"

if [ "$decoder" != ffmpeg ] || ! command -v ffprobe >/dev/null 2>&1; then
  echo "fetch-fixtures: the der set needs ffmpeg and ffprobe" >&2
  exit 1
fi

# Download $2 to "$ami/$1" if it is not already there, verifying it before it
# is allowed to stay: a wav that ffprobe cannot read and an RTTM that is not
# RTTM (an HTML error page saved under the right name, say) both get deleted,
# so the next run retries rather than scoring garbage.
fetch_ami() {
  local name=$1 url=$2 kind=$3 meeting=$4
  local dest="$ami/$name"
  if [ -f "$dest" ]; then return 0; fi
  echo "fetching $name ..."
  if ! curl --fail --location --silent --show-error -o "$tmp/$name" "$url"; then
    rm -f "$tmp/$name"
    echo "fetch-fixtures: download failed: $url" >&2
    exit 1
  fi
  mv "$tmp/$name" "$dest"
  if [ "$kind" = wav ]; then
    if ! ffprobe -v error -show_entries format=duration -of csv=p=0 "$dest" >/dev/null; then
      rm -f "$dest"
      echo "fetch-fixtures: not a readable wav, deleted it: $url" >&2
      exit 1
    fi
  elif ! awk -v m="$meeting" '
      NF == 0 { next }
      $1 != "SPEAKER" || $2 != m { exit 1 }
      { turns++ }
      END { if (turns == 0) exit 1 }
    ' "$dest"; then
    rm -f "$dest"
    echo "fetch-fixtures: not an RTTM for $meeting, deleted it: $url" >&2
    exit 1
  fi
  shasum -a 256 "$dest" | awk '{ printf "%s  %s\n", $1, "'"$name"'" }'
}

mkdir -p "$ami" "$der_out"
for m in $meetings; do
  fetch_ami "$m.Mix-Headset.wav" "$audio_base/$m/audio/$m.Mix-Headset.wav" wav "$m"
  fetch_ami "$m.rttm" "$rttm_base/$rttm_rev/only_words/rttms/test/$m.rttm" rttm "$m"
done

# Every run, cached or fresh: the pinned digests are the fixture's identity.
digest_fail=""
for m in $meetings; do
  for name in "$m.Mix-Headset.wav" "$m.rttm"; do
    have=$(shasum -a 256 "$ami/$name" | awk '{ print $1 }')
    want=$(printf '%s\n' "$ami_digests" | awk -v n="$name" '$2 == n { print $1 }')
    if [ -z "$want" ]; then
      echo "fetch-fixtures: $name is not pinned; add to ami_digests:" >&2
      echo "$have  $name" >&2
      digest_fail=1
    elif [ "$have" != "$want" ]; then
      echo "fetch-fixtures: $name changed upstream: pinned $want, got $have" >&2
      digest_fail=1
    fi
  done
done
[ -z "$digest_fail" ] || exit 1

der_entries=""
for m in $meetings; do
  der_wav="$der_out/$m.wav"
  der_rttm="$der_out/$m.rttm"

  if [ -z "$force" ] && [ -f "$der_wav" ] && [ -f "$der_rttm" ]; then
    echo "already present: $der_wav"
    echo "already present: $der_rttm"
  else
    ffmpeg -v error -nostdin -y -i "$ami/$m.Mix-Headset.wav" \
      -t "$der_seconds" -ac 1 -ar "$rate" -sample_fmt s16 "$tmp/$m.wav"
    mv "$tmp/$m.wav" "$der_wav"
    # The reference is cut to match: turns starting past the cut are dropped
    # and a turn straddling it is clipped, so no reference speech is claimed
    # for audio the fixture does not contain. Same 10-field RTTM layout.
    awk -v lim="$der_seconds" '
      NF == 0 { next }
      $4 + 0 < lim {
        dur = $5 + 0
        if ($4 + dur > lim) dur = lim - $4
        printf "SPEAKER %s %s %.2f %.2f %s %s %s %s %s\n", $2, $3, $4, dur, $6, $7, $8, $9, $10
      }
    ' "$ami/$m.rttm" >"$tmp/$m.rttm"
    mv "$tmp/$m.rttm" "$der_rttm"
    echo "wrote $der_wav (${der_seconds}s, 16 kHz mono 16-bit)"
    echo "wrote $der_rttm ($(wc -l <"$der_rttm" | tr -d ' ') turns)"
  fi

  files=$((files + 2))
  total=$(awk -v a="$total" -v b="$der_seconds" 'BEGIN { printf "%.2f", a + b }')
  der_entries="$der_entries$(
    printf '  {"wav": "%s", "rttm": "%s", "meeting": "%s", "seconds": %d}' \
      "$der_wav" "$der_rttm" "$m" "$der_seconds"
  )"$'\n'
done

der_manifest="$der_out/manifest.json"
if [ -z "$force" ] && [ -f "$der_manifest" ]; then
  echo "already present: $der_manifest"
else
  {
    echo '['
    printf '%s' "$der_entries" | sed '$!s/$/,/'
    echo ']'
  } >"$der_manifest"
  echo "wrote $der_manifest"
fi
files=$((files + 1))

echo "FIXTURES OK $files files ${total}s"
