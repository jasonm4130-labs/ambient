#!/usr/bin/env bash
# Reject builder home paths. An optional prefix supports focused tests without
# changing HOME.
#
# --helper is for ambient-engine alone. FluidAudio links a precompiled Rust
# archive (NemoTextProcessing.xcframework) whose panic locations name its own
# CI runner's cargo registry. Nothing in the helper's own build uses cargo, so
# in that binary those paths can only be upstream's; in `ambient` they would be
# ours, and stay refused.
set -euo pipefail
helper=0
if [ "${1:-}" = --helper ]; then
  helper=1
  shift
fi
binary="${1:?usage: scripts/check-build-paths [--helper] <binary> [home-prefix]}"
home_prefix="${2:-${HOME:-}}"
test -f "$binary"
if [ -z "$home_prefix" ] || [ "$home_prefix" = / ]; then
  exit 0
fi
if ! LC_ALL=C strings -a "$binary" | LC_ALL=C awk -v home="$home_prefix/" -v helper="$helper" '
  {
    if (helper) gsub("/Users/runner/.cargo/registry/src/", "/upstream/cargo-registry/")
    if (index($0, home)) leak = 1
  }
  END { exit leak ? 1 : 0 }
'; then
  echo "release binary contains the build user's home path; refusing to package" >&2
  exit 1
fi
