{
  "permissions": {
    "allow": [
      "Bash(scripts/check:*)",
      "Bash(./scripts/check:*)",
      "Bash(./merge-pr.sh:*)",
      "Bash(loop/task-brief:*)",
      "Bash(./loop/task-brief:*)",
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(./loop/merge-pr.sh:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-route-around-ci.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests-are-readonly.mjs\""
          }
        ]
      }
    ]
  }
}
