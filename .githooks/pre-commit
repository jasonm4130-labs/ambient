#!/usr/bin/env bash
# Two refusals, both for things CI checks too late to matter.
#
#   1. No commits on main. Changes reach main through a pull request whose CI
#      is green, merged with a merge commit by ./merge-pr.sh. The plan this
#      repo is on has no branch protection, so the rule lives here.
#   2. Staged Rust must be rustfmt-clean. `cargo fmt --check` has always been
#      the rust job's first step, and it stayed red on main for six pushes
#      before anyone looked.
#
# Only the staged files are checked, so drift elsewhere in the tree — or in
# the unstaged half of a partially staged file — does not block an unrelated
# commit. Run `cargo fmt` to fix; there is no bypass flag on purpose.
#
# The global hooks path (`core.hooksPath`) dispatches here when this file is
# executable; see docs/developing/branching.md.
set -euo pipefail

branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = "main" ]; then
  echo ""
  echo "❌ no commits on main."
  echo "   git switch -c <topic>    then open a PR and merge it with ./merge-pr.sh"
  exit 1
fi

if ! command -v rustfmt >/dev/null 2>&1; then
  echo "⚠ rustfmt not installed — skipping format check"
  exit 0
fi

staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.rs')

if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

# Check the staged *content*, not the working tree: a file formatted after
# `git add` would otherwise pass here and fail in CI.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
bad=()
for f in "${staged[@]}"; do
  mkdir -p "$tmp/$(dirname "$f")"
  git show ":$f" > "$tmp/$f"
  if ! rustfmt --check --edition 2021 "$tmp/$f" >/dev/null 2>&1; then
    bad+=("$f")
  fi
done

if [ "${#bad[@]}" -gt 0 ]; then
  echo ""
  echo "❌ rustfmt would change staged file(s):"
  printf '   %s\n' "${bad[@]}"
  echo "   Run: cargo fmt && git add ${bad[*]}"
  exit 1
fi
